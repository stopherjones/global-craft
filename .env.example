# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional client-side overrides when deploying static frontend to GitHub Pages
# paired with a Cloudflare Worker backend:
# VITE_API_BASE_URL="https://your-worker.example.workers.dev"
# VITE_SAVE_ENDPOINT="https://your-worker.example.workers.dev/saves"
